# ─── Backend API ─────────────────────────────────────────────────────
# URL бекенда з БД (див. BACKEND_SPEC.md у корені репозиторію).
# Задай — і фронт ходитиме на API (state/open/sell/upgrade/deposit/admin).
# Порожньо — локальний демо-стан у пам'яті, все скидається при reload.
# На беку має бути CORS з credentials (cookie-сесія).
VITE_API_URL=

# ─── Steam авторизація (steamAuthPlugin.js) ──────────────────────────

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Якщо задано: профіль тягнеться через офіційне GetPlayerSummaries API
# (надійніше, стабільні дані). Якщо порожньо — fallback на XML-сторінку
# профілю steamcommunity.com (працює і без ключа, але менш стабільно).
STEAM_API_KEY=

# Оригін сайту для Steam OpenID return_to.
# Локально не потрібно — визначається автоматично з запиту.
# Задай у проді або за проксі/ngrok, напр.:
# STEAM_AUTH_ORIGIN=https://bat-case.example.com
STEAM_AUTH_ORIGIN=

# ─── Base44 Vite plugin (vite.config.js) ─────────────────────────────
# Плагін лишився з шаблону. Без цих змінних сайт працює нормально —
# попередження "[base44] No Base44 backend configured" можна ігнорувати.

# URL бекенду Base44 (не використовується — свій бекенд див. Back/).
VITE_BASE44_APP_BASE_URL=

# 'true' — якщо код імпортує старий SDK (@/integrations, @/entities).
BASE44_LEGACY_SDK_IMPORTS=false
