# Database
DATABASE_URL=postgres://user:password@localhost:5432/bat_case
# або sqlite:./data.db

# Sessions
SESSION_SECRET=change-me-random-string

# Steam OpenID (optional — without it falls back to public XML profile)
STEAM_API_KEY=
STEAM_AUTH_ORIGIN=http://localhost:5173

# Admin panel credentials (replaces hardcoded admin/admin on frontend)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Server
PORT=8080
